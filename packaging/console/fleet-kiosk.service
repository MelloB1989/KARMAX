[Unit]
Description=Fleet console kiosk (X on tty1, Chrome on the panel)
After=systemd-user-sessions.service plymouth-quit-wait.service fleet-console.service
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
User=@KIOSK_USER@
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
Environment=FLEET_CONSOLE_ENV=@CONSOLE_ENV@
ExecStart=/usr/bin/xinit @KIOSK_SESSION@ -- :0 vt1 -nolisten tcp
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
