# console.env — every value install.sh and kiosk-session.sh use. Copy to console.env and edit.
# Nothing here is a secret. The client token is generated into $CONSOLE_DIR/client.token.

# The kiosk user: owns the console, autologs in on tty1, runs Chrome and RustDesk's display.
# On PC2 this is the host's existing operator user, not a new account: fleet-console runs
# docker exec for the agents' terminals, so the user must be in the docker group (and in
# video and render for the display). install.sh's check step verifies all three.
KIOSK_USER=kiosk

# The directory holding console.yaml and client.token (rendered by `fleetctl render`).
CONSOLE_DIR=/home/kiosk/.config/fleet-console
# The fleet-console binary, as the kiosk user's ExecStart.
CONSOLE_BIN=/home/kiosk/.local/bin/fleet-console
# The console's listen address (loopback); the kiosk opens http://$CONSOLE_LISTEN/login?k=…
CONSOLE_LISTEN=127.0.0.1:7880

# The virtual output. Pick the unused connector from /sys/class/drm/card*-<CONNECTOR>/status.
CONNECTOR=HDMI-A-1
MODE_W=1920
MODE_H=1080
MODE_HZ=60
# The time zone the panel shows times in (the host may run on UTC). Empty: the host's.
DISPLAY_TZ=
# Kernel parameter that takes the EDID; leave empty to detect it with modinfo
# (drm.edid_firmware or drm_kms_helper.edid_firmware).
EDID_PARAM=

# Google Chrome, from its apt repository.
CHROME_PKG=google-chrome-stable
CHROME_APT_URL=https://dl.google.com/linux/chrome/deb/
CHROME_KEY_URL=https://dl.google.com/linux/linux_signing_key.pub

# RustDesk: a pinned .deb. RUSTDESK_SHA256 is the sha256 of that file; the install stops on a mismatch.
RUSTDESK_VERSION=1.4.0
RUSTDESK_URL=https://github.com/rustdesk/rustdesk/releases/download/1.4.0/rustdesk-1.4.0-x86_64.deb
RUSTDESK_SHA256=replace-with-the-sha256-of-the-deb
# public: RustDesk's rendezvous servers. direct: direct IP access (LAN or Tailscale) only.
RUSTDESK_MODE=public
RUSTDESK_DIRECT_PORT=21118
