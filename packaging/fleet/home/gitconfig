[gc]
	# git gc runs from a cron on the host, so eight agents never gc one .git at once.
	auto = 0
[init]
	defaultBranch = main
[push]
	autoSetupRemote = true
# GitHub over HTTPS with the fleet's token (GH_TOKEN, fleet.yaml github:), via
# gh. Containers hold no SSH keys, so the operator's SSH remotes — including
# their ~/.ssh/config aliases — are rewritten to HTTPS here.
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[url "https://github.com/"]
	insteadOf = git@github.com:
	insteadOf = ssh://git@github.com/
	insteadOf = git@github:
	insteadOf = git@contoso:
	insteadOf = git@workgit:
