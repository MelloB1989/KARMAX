#!/bin/sh
# git's credential helper for github.com in the fleet (/etc/gitconfig): the
# token for the repository's owner, from fleet-gh-token. /etc/gitconfig sets
# useHttpPath, so git sends the path (owner/repo.git) the owner is read from.
# Only "get" is answered: there is nothing to store or erase.
[ "${1:-}" = get ] || exit 0
path=
while IFS= read -r line && [ -n "$line" ]; do
  case $line in path=*) path=${line#path=} ;; esac
done
t=$(fleet-gh-token "${path%%/*}")
[ -n "$t" ] || exit 0
printf 'username=x-access-token\npassword=%s\n' "$t"
