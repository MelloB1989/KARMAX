#!/bin/sh
# agent-run — keeps one interactive `claude --name $FLEET_AGENT` alive in the
# tmux session "main", under tini. See docs/AGENT-FLEET.md, "The agent container".
#
# /work/.fleet/next says what the next pane starts on, and is consumed:
#   a session id  -> --resume it        (fleetd restarting, restoring)
#   empty         -> a fresh session    (fleetd rotating)
#   absent        -> resume the current one (/work/.fleet/current), else fresh
# fleetd never types into the pane to do any of this: it writes next and
# kills the pane, and this loop starts the next one.
set -u
: "${FLEET_AGENT:?FLEET_AGENT is not set}"
W="${FLEET_WORK:-/work}/.fleet"
C="$HOME/.claude"

event() { # a line in the hook log, so fleetd records what this loop did
  # (the third argument is a detail). With HOME unwritable the log cannot
  # live under it: it goes to $W/events.jsonl, which fleetd reads too.
  d="$C/fleet"; [ -w "$d" ] || d="$W"
  mkdir -p "$d" 2>/dev/null
  jq -nc --arg e "$1" --arg s "$2" --arg d "${3:-}" \
    '{t: (now|floor), event: $e, session: $s} + (if $d != "" then {detail: $d} else {} end)' >> "$d/events.jsonl" 2>/dev/null
}

# The shared code directory must really be there. A container's bind mount is
# fixed when it starts: after a reboot Docker can start us on the empty
# autofs stub of the NFS share (the automount satisfies its mount dependency),
# and no loop in here would ever see the real mount appear. So say so, wait a
# moment (so the restart policy does not spin), and EXIT non-zero: Docker
# restarts the container, which re-binds the mount. fleetd alerts on the event.
code="${FLEET_CODE:-$HOME/code}"
if [ -z "$(ls -A "$code" 2>/dev/null | head -n 1)" ]; then
  echo "agent-run: the code directory $code is missing or empty (the share is not mounted yet?); exiting so the container restarts and re-binds it." >&2
  event "agent-run.code_missing" "" "$code"
  sleep "${FLEET_CODE_RETRY:-20}"
  exit 1
fi

# HOME must be writable: Claude Code keeps ~/.claude.json there, and a start
# without it opens the first-run wizard, which hears no messages. That is an
# image built with a home that is not fleet.yaml's (`fleetctl image build`
# takes it from there). Say so, loudly, and keep retrying — never start
# claude into onboarding. fleetd alerts on the event.
home_writable() {
  [ -d "$HOME" ] && t=$(mktemp "$HOME/.agent-run.XXXXXX" 2>/dev/null) && rm -f "$t"
}
while ! home_writable; do
  echo "agent-run: HOME=$HOME is not writable by uid $(id -u); the image's home does not match fleet.yaml — rebuild it with 'fleetctl image build'. Retrying." >&2
  event "agent-run.home_unwritable" "" "$HOME uid=$(id -u)"
  sleep "${FLEET_HOME_RETRY:-30}"
done

mkdir -p "$W" /work/wt "$C/fleet" "$C/sessions"

# Fleet-managed settings, refreshed on every start so an image update reaches
# an existing volume. The agent's brief arrives in its env (rendered by
# fleetctl), which is how it reaches another host's docker daemon too.
cp /opt/fleet/settings.json "$C/settings.json"
if [ -n "${FLEET_CLAUDE_MD:-}" ]; then
  printf '%s' "$FLEET_CLAUDE_MD" | base64 -d > "$C/CLAUDE.md"
fi
# The build host's key (fleet.yaml build:), for DOCKER_HOST=ssh://… and kbuild.
if [ -n "${FLEET_BUILD_KEY:-}" ] && [ -n "${DOCKER_HOST:-}" ]; then
  bh=${DOCKER_HOST#ssh://}; bh=${bh#*@}; bh=${bh%%:*}
  (umask 077; mkdir -p "$HOME/.ssh"
   printf '%s' "$FLEET_BUILD_KEY" | base64 -d > "$HOME/.ssh/fleet_build"
   printf 'Host %s\n  IdentityFile ~/.ssh/fleet_build\n  IdentitiesOnly yes\n  StrictHostKeyChecking accept-new\n' "$bh" > "$HOME/.ssh/config")
fi
# The operator's own ssh_config names for github.com (fleet.yaml
# github.ssh_aliases), rewritten to HTTPS like github.com's own forms in
# /etc/gitconfig, so a clone made on the host as git@<alias>: still pushes.
git config --global --unset-all url.https://github.com/.insteadOf 2>/dev/null
for a in ${FLEET_GITHUB_SSH_ALIASES:-}; do
  git config --global --add url.https://github.com/.insteadOf "git@$a:"
done
# (The bypass-mode warning is skipped by skipDangerousModePermissionPrompt in
# settings.json, copied in above on every start: Claude Code moves
# bypassPermissionsModeAccepted out of this file into the user settings once,
# then never asks again only while that setting survives. A restart keeps
# this file but the copy above restores the setting, so restart = recreate.)
# Onboarding done, /work and the shared code trusted, bypass mode accepted,
# the "make auto mode your default?" nudge seen (2.1.294 opens it on first
# start, and the pane then sits on it, deaf to messages) — merged into
# whatever Claude Code already keeps there, on every start. fleetd alerts on
# any dialog a later version adds.
[ -s "$HOME/.claude.json" ] || echo '{}' > "$HOME/.claude.json"
jq --arg code "${FLEET_CODE:-$HOME/code}" '. * {
    hasCompletedOnboarding: true, bypassPermissionsModeAccepted: true, hasSeenAutoDefaultNudge: true,
    projects: {"/work": {hasTrustDialogAccepted: true}, ($code): {hasTrustDialogAccepted: true}}
  }' "$HOME/.claude.json" > "$HOME/.claude.json.tmp" && mv "$HOME/.claude.json.tmp" "$HOME/.claude.json"

quick=0
start() {
  if [ -f "$W/next" ]; then
    sid=$(cat "$W/next"); rm -f "$W/next"; quick=0
  else
    sid=$(cat "$W/current" 2>/dev/null)
    # Three panes in a row that died within 30s: the session will not come
    # back, so start fresh rather than loop on it. fleetd sees the event.
    if [ "$quick" -ge 3 ]; then
      event "agent-run.fresh_after_crashes" "$sid"; sid=""; quick=0
    elif [ -n "$sid" ] && ! ls "$C"/projects/*/"$sid".jsonl >/dev/null 2>&1; then
      sid="" # never had a turn: nothing to resume
    fi
  fi
  if [ -n "$sid" ]; then
    flag="--resume $sid"
  else
    sid=$(cat /proc/sys/kernel/random/uuid); flag="--session-id $sid"
  fi
  printf '%s\n' "$sid" > "$W/current"
  model=""
  [ -n "${FLEET_MODEL:-}" ] && model="--model $FLEET_MODEL"
  started=$(date +%s)
  tmux new-session -d -s main -x 220 -y 50 -c /work \
    "exec claude --name $FLEET_AGENT --dangerously-skip-permissions $flag $model"
}

trap 'tmux kill-server 2>/dev/null; exit 0' TERM INT
started=0
while :; do
  if ! tmux has-session -t main 2>/dev/null; then
    # A host that has just booted is still bringing its mounts and network
    # up: a pane that dies in its first minutes says nothing about the
    # session, so it does not count (a power-cycling host must not lose its
    # session). /proc/uptime is the host's.
    up=$(cut -d. -f1 /proc/uptime 2>/dev/null); up=${up:-99999}
    if [ "$started" -gt 0 ] && [ "$up" -lt "${FLEET_BOOT_GRACE:-300}" ]; then
      :
    elif [ "$started" -gt 0 ] && [ $(( $(date +%s) - started )) -lt 30 ]; then
      quick=$((quick + 1))
    elif [ "$started" -gt 0 ]; then
      quick=0
    fi
    start
  fi
  sleep 2
done
