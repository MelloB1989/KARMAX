    "@xterm/xterm": "5.5.0",
    "fast-json-patch": "3.1.1",
    "motion": "11.11.17",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.169.0"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
